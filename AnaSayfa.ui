  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-image: url(&quot;dist/altay2.png&quot;);
    background-repeat: no-repeat;
    background-position: center;
    background-color: rgba(255, 255, 255, 0.4);
}
QWidget {
    background-color:#f0f8ff rgba(255, 255, 255, 0.9);
    border-radius: 10px;
    /*background-color: #f0f8ff;  Açık mavi */
    color: #2e2e2e; /* Koyu gri yazı */
    font-family: Arial;
    font-weight: bold;
    font-size: 14px;
    
}

QLabel {
    color: #0079A8; /* Canlı camgöbeği */
    font-weight: bold;
}

QPushButton {
    background-color: #0079A8; /* Canlı yeşil-mavi */
    color: white;
    border: 1px solid #55efc4;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #00cec9;
}

QLineEdit, QComboBox, QDateEdit, QTextEdit, QSpinBox {
    background-color: #dfe6e9; /* Açık gri */
    color: #2d3436; /* Koyu gri */
    border: 1px solid #81ecec;
    border-radius: 4px;
}

QTableWidget {
    background-color: #dfe6e9; /* Açık camgöbeği */
    color: #0079A8;
    gridline-color: #0079A8;
    alternate-background-color: #dff9fb;
}

QHeaderView::section {
    background-color: #0079A8;
    color: white;
    padding: 5px;
    border: 1px solid #55efc4;
    font-weight: bold;
}
@Layout{
    background-color: rgba(255, 255, 255, 180);
    border-radius: 10px;
}
</string>
